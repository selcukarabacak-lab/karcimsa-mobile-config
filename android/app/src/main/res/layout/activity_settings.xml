<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/karcimsa_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/closeSettingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="‹"
                android:textSize="28sp"
                android:textColor="@color/karcimsa_text"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ayarlar"
                    android:textColor="@color/karcimsa_text"
                    android:textStyle="bold"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="KARÇİMSA Silo Operasyon"
                    android:textColor="@color/karcimsa_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BİLDİRİMLER"
            android:textColor="@color/karcimsa_blue"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/salesNotificationsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Satış Bildirimleri"
                android:textColor="@color/karcimsa_text"
                android:textStyle="bold"
                android:textSize="16sp"
                android:checked="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Satış araçları fabrikaya giriş yaptığında bildirim alın."
                android:textColor="@color/karcimsa_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="#203B4D" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cem1NotificationsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gelen CEM I Bildirimleri"
                android:textColor="@color/karcimsa_text"
                android:textStyle="bold"
                android:textSize="16sp"
                android:checked="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="CEM I araçları fabrikaya giriş yaptığında bildirim alın."
                android:textColor="@color/karcimsa_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="UYGULAMA"
            android:textColor="@color/karcimsa_blue"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/keepScreenOnSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ekranı Açık Tut"
                android:textColor="@color/karcimsa_text"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Panel açıkken telefonun ekranının otomatik kapanmasını engeller."
                android:textColor="@color/karcimsa_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="13dp"
                android:background="#203B4D" />

            <LinearLayout
                android:id="@+id/autoRefreshRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Otomatik Yenileme"
                        android:textColor="@color/karcimsa_text"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Panel verilerini seçilen aralıkta sessizce yeniler."
                        android:textColor="@color/karcimsa_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/autoRefreshValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:text="30 sn  ›"
                    android:textColor="@color/karcimsa_blue"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SİSTEM"
            android:textColor="@color/karcimsa_blue"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card">

            <TextView
                android:id="@+id/refreshNowRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:paddingBottom="12dp"
                android:text="Verileri Yenile  ›"
                android:textColor="@color/karcimsa_text"
                android:textStyle="bold"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#203B4D" />

            <TextView
                android:id="@+id/clearCacheRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="5dp"
                android:text="Önbelleği Temizle  ›"
                android:textColor="@color/karcimsa_text"
                android:textStyle="bold"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="HAKKINDA"
            android:textColor="@color/karcimsa_blue"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KARÇİMSA Silo Operasyon"
                android:textColor="@color/karcimsa_text"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Sürüm"
                android:textColor="@color/karcimsa_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Tercihleriniz otomatik kaydedilir."
            android:textColor="@color/karcimsa_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>